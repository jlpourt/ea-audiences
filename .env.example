# ---------------------------------------------------------------------------
# 2K Courtside — Audience Builder & Segmentation Engine
# Take-Two Identity Graph · Configuration
#
# Copy to `.env.local` and adjust. Every value here has a default in
# `src/lib/config.ts` and `src/lib/models.ts`.
#
# AUTH: No API keys or secrets are stored here. All Spanner, BigQuery,
# Cloud Storage, Pub/Sub, and Vertex AI clients authenticate via
# Application Default Credentials (ADC).
# ---------------------------------------------------------------------------

# --- Google Cloud Project ---
GCP_PROJECT_ID=jamie-bq-test
GCP_REGION=us-central1

# --- Cloud Spanner Graph (TakeTwoPlayerGraph) ---
# Schema:  schema/twok_graph_db.ddl
# Create:  python3 scripts/spanner_create_db.py
# Load:    node scripts/spanner_load_data.js --truncate
SPANNER_INSTANCE_ID=blackrock-spanner
SPANNER_DATABASE_ID=twok_graph_db

# --- BigQuery, Cloud Storage & Pub/Sub ---
BQ_DATASET_ID=twok_marketing_intelligence
GCS_BUCKET_NAME=twok-courtside-media-jamie-bq-test
PUBSUB_TOPIC=twok-courtside-activations
ADK_AGENT_SERVICE_URL=http://127.0.0.1:8080

# --- Vertex AI Model Overrides (optional; defaults in src/lib/models.ts) ---
MODEL_REASONING=gemini-3.1-pro-preview
MODEL_FAST=gemini-3.5-flash
MODEL_LITE=gemini-3.5-flash-lite
MODEL_GROUNDED=gemini-3.5-flash
MODEL_IMAGE=gemini-2.5-flash-image
MODEL_TTS=gemini-3.1-flash-tts-preview
MODEL_MUSIC=lyria-002
MODEL_EMBED=gemini-embedding-001

# --- Reddit Grounding (optional) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=twok-courtside-intelligence/1.0
