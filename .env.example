# ---------------------------------------------------------------------------
# ABK Audience Intelligence Engine — configuration
#
# Copy to `.env.local` and adjust. Every value here has a default in
# `src/lib/config.ts`, so the app runs without this file; it exists so that a
# handoff copy of the code documents exactly what it talks to.
#
# AUTH: there is no key or secret below. The Spanner and Vertex clients use
# Application Default Credentials. Run:
#     gcloud auth application-default login
# ---------------------------------------------------------------------------

# --- Google Cloud project ---
GCP_PROJECT_ID=jamie-bq-test
GCP_REGION=us-central1

# --- Cloud Spanner (the ONLY source of player data) ---
# The app is live-only: if this database is unreachable the UI shows an explicit
# error rather than falling back to local files.
# Schema:  schema/abk_graph_db.ddl
# Create:  python3 scripts/spanner_create_db.py
# Load:    node scripts/spanner_load_data.js --truncate
SPANNER_INSTANCE_ID=blackrock-spanner
SPANNER_DATABASE_ID=abk_graph_db

# --- Vertex AI ---
VERTEX_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=text-embedding-004

# --- Optional / secondary surfaces ---
BQ_DATASET_ID=abk_marketing_intelligence
GCS_BUCKET_NAME=abk-audiences-data-jamie-bq-test
ADK_AGENT_SERVICE_URL=http://localhost:8080

# --- Reddit grounding (optional) ---
# Without these the corpus builder falls back to unauthenticated RSS, which
# yields titles and permalinks but no scores or comments.
# Register a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=abk-audience-intelligence/1.0
